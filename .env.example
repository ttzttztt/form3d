# 本地工作台，TripoSR 自动建模不需要 API 密钥。
IMG3D_DATA_DIR=.data
# 云端调用会把已裁剪/擦除的图片传给 Meshy，按供应商规则计费。
# MESHY_API_KEY=
# 可选：固定已在账号中验证可用的模型；留空使用供应商默认模型。
# MESHY_AI_MODEL=
# 本地目标检测（Python 环境需有 torch、torchvision、transformers）
# VISION_PYTHON=D:/path/to/vision/python.exe
# VISION_DEVICE=auto
# 本地图生 3D（默认使用项目下 .venv-3d/Scripts/python.exe）
# LOCAL3D_PYTHON=D:/path/to/local3d/python.exe
# Hunyuan3D-2mini 几何实验环境（与 TripoSR 分开）
# HUNYUAN_PYTHON=D:/path/to/hunyuan/python.exe
# SAM 2 目标分割独立环境（默认 .venv-sam2/Scripts/python.exe）
# SAM2_PYTHON=D:/path/to/sam2/python.exe
# 本地输入清理（OCR CPU + 复用目标检测权重）
# PREFLIGHT_PYTHON=D:/path/to/preflight/python.exe
# 部件优先生成：PartCrafter 独立环境（默认 .venv-parts/bin/python 或 Scripts/python.exe）
# PARTS_PYTHON=/path/to/parts/python
# Blender（对话建模与多视角渲染）；不设置时按 PATH 和常见安装位置查找
# BLENDER_EXE=/path/to/blender
# PartCrafter 权重下载地址（默认 https://hf-mirror.com）
# HF_ENDPOINT=https://huggingface.co
