{
  "name": "img-to-3d-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "test:js": "node tests/js/run.mjs",
    "test:e2e": "node tests/e2e/test_smoke.mjs",
    "format": "prettier --write \"apps/web/src/**/*.{ts,tsx,css}\" apps/web/vite.config.ts \"tests/**/*.mjs\" services/workers/check_asset.cjs",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,tsx,css}\" apps/web/vite.config.ts",
    "test:e2e:full": "node tests/e2e/test_workbench.mjs"
  },
  "dependencies": {
    "gltf-validator": "^2.0.0-dev.3.10",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.8.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.51.1",
    "prettier": "^3.5.3",
    "typescript": "~5.7.3",
    "vite": "^6.4.1"
  }
}
